{
  "display_information": {
    "name": "MAC-hand Slack",
    "description": "Continue your local Orca and Claude Code sessions from Slack",
    "background_color": "#172b4d"
  },
  "features": {
    "app_home": { "home_tab_enabled": true, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "bot_user": { "display_name": "MAC-hand", "always_online": false },
    "slash_commands": [{ "command": "/orca", "description": "打开 Orca 会话控制台", "should_escape": false }]
  },
  "oauth_config": {
    "scopes": { "bot": ["commands", "chat:write", "channels:read", "channels:history", "groups:read", "groups:write", "groups:history", "im:history", "im:read", "im:write", "files:read"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_home_opened", "message.channels", "message.groups", "message.im"] },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
